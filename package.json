{
  "name": "projeto-nexo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:push": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs push --force",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx src/db/seed.ts",
    "db:setup": "npm run db:push && npm run db:seed",
    "agent:smoke": "node --env-file-if-exists=.env.local --import tsx scripts/smoke-agent.mts",
    "evals": "node --env-file-if-exists=.env.local --import tsx scripts/evals.mts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.109",
    "@libsql/client": "^0.18.0",
    "@mastra/core": "^1.81.0",
    "ai": "^7.0.159",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
