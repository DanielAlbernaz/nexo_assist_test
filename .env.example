# Copie para .env.local e preencha. Nunca commite o .env.local.

# Provedor de LLM: google | anthropic | openai
LLM_PROVIDER=google
LLM_MODEL=gemini-flash-lite-latest

# Chave do provedor escolhido (Google AI Studio: https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=

# Banco: arquivo local no desenvolvimento, Turso em produção
DATABASE_URL=file:./data/nexo.db
DATABASE_AUTH_TOKEN=

# Segredo para assinar a sessão (gere com: openssl rand -hex 32)
SESSION_SECRET=

# Limite de mensagens por sessão (custo)
MAX_MESSAGES_PER_SESSION=30

# Simulação do sistema de chamados legado (0 = sempre disponível)
TICKET_SERVICE_FAILURE_RATE=0
TICKET_SERVICE_LATENCY_MS=0
